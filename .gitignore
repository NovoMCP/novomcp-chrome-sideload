# Extension signing key — NEVER commit. The public key derived from this
# is embedded in manifest.json (`key` field) which IS safe to commit.
# Private key is only needed if we ever side-load .crx outside the Web Store.
extension-key.pem
pubkey.der
pubkey.b64.txt
.extension-id

